    INT     shift, and go to state 1
    FLOAT   shift, and go to state 2
    CHAR    shift, and go to state 3
    DOUBLE  shift, and go to state 4

    program    go to state 5
    functions  go to state 6
    function   go to state 7
    type       go to state 8


